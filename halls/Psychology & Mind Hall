  const root = document.getElementById("arshif-psych-hall");
  const $ = sel => root.querySelector(sel);
  const $$ = sel => Array.from(root.querySelectorAll(sel));

  const state = { department:"All", era:"All", search:"", quizIndex:0, quizScore:0, quizAnswered:false };

  const storage = {
    get(key, fallback) {
      try { const raw = localStorage.getItem("arshifPsychMind:" + key); return raw ? JSON.parse(raw) : fallback; }
      catch(e) { return fallback; }
    },
    set(key, value) { localStorage.setItem("arshifPsychMind:" + key, JSON.stringify(value)); }
  };

  let completed = storage.get("completedModules", {});
  let favorites = storage.get("favorites", {});
  let dossierNotes = storage.get("dossierNotes", {});
  let generalNotes = storage.get("generalNotes", "");

  function escapeHTML(s) {
    return String(s || "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"}[c]));
  }

  function tabInit() {
    $$(".psy-tab").forEach(btn => {
      btn.addEventListener("click", () => {
        $$(".psy-tab").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        $$(".psy-view").forEach(v => v.classList.remove("active"));
        $("#view-" + btn.dataset.view).classList.add("active");
      });
    });
  }

  function renderChips() {
    const depWrap = $("#departmentChips");
    const eraWrap = $("#eraChips");
    const eras = ["All", ...Array.from(new Set(DATA.dossiers.map(d => d.era))).sort()];
    depWrap.innerHTML = ["All", ...DATA.departments].map(dep => `<button class="psy-chip ${dep===state.department?'active':''}" data-dep="${escapeHTML(dep)}">${escapeHTML(dep)}</button>`).join("");
    eraWrap.innerHTML = eras.map(era => `<button class="psy-chip ${era===state.era?'active':''}" data-era="${escapeHTML(era)}">${escapeHTML(era)}</button>`).join("");
    depWrap.querySelectorAll("[data-dep]").forEach(chip => chip.addEventListener("click", () => { state.department = chip.dataset.dep; renderArchive(); renderChips(); }));
    eraWrap.querySelectorAll("[data-era]").forEach(chip => chip.addEventListener("click", () => { state.era = chip.dataset.era; renderArchive(); renderChips(); }));
  }

  function dossierMatches(d) {
    const q = state.search.trim().toLowerCase();
    const depOK = state.department === "All" || d.department === state.department;
    const eraOK = state.era === "All" || d.era === state.era;
    const hay = [d.title,d.department,d.era,d.badge,d.tags,d.summary,d.historicalContext].join(" ").toLowerCase();
    return depOK && eraOK && (!q || hay.includes(q));
  }

  function renderArchive() {
    const list = DATA.dossiers.filter(dossierMatches);
    $("#archiveCount").textContent = `${list.length} of ${DATA.dossiers.length} dossiers shown.`;
    $("#dossierGrid").innerHTML = list.map(d => `
      <article class="psy-card">
        <span class="psy-badge">${escapeHTML(d.badge)} · ${escapeHTML(d.department)}</span>
        <h3>${escapeHTML(d.title)}</h3>
        <div class="psy-meta">${escapeHTML(d.era)}</div>
        <p>${escapeHTML(d.summary)}</p>
        <div class="psy-actions">
          <button class="psy-btn gold" data-open="${escapeHTML(d.id)}">Open Dossier</button>
          <button class="psy-btn" data-fav="${escapeHTML(d.id)}">${favorites[d.id] ? "★ Favorited" : "☆ Favorite"}</button>
        </div>
      </article>
    `).join("");
    $("#dossierGrid").querySelectorAll("[data-open]").forEach(btn => btn.addEventListener("click", () => openDossier(DATA.dossiers.find(d => d.id === btn.dataset.open))));
    $("#dossierGrid").querySelectorAll("[data-fav]").forEach(btn => btn.addEventListener("click", () => {
      favorites[btn.dataset.fav] = !favorites[btn.dataset.fav];
      storage.set("favorites", favorites);
      renderArchive();
    }));
  }

  function renderCourse() {
    $("#courseGrid").innerHTML = DATA.modules.map((m, idx) => `
      <article class="psy-module">
        <div class="psy-module-top">
          <div>
            <span class="psy-badge">${String(idx+1).padStart(2,"0")} · ${escapeHTML(m.level)} · ${escapeHTML(m.department)}</span>
            <h3>${escapeHTML(m.title)}</h3>
          </div>
          <button class="psy-check ${completed[m.id]?'done':''}" data-complete="${escapeHTML(m.id)}" title="Mark complete">${completed[m.id]?'✓':'○'}</button>
        </div>
        <p>${escapeHTML(m.summary)}</p>
        <ul class="psy-objectives">${m.objectives.map(o => `<li>${escapeHTML(o)}</li>`).join("")}</ul>
        <p><strong style="color:var(--psy-gold)">Activity:</strong> ${escapeHTML(m.activity)}</p>
        <div class="psy-actions"><button class="psy-btn gold" data-module="${escapeHTML(m.id)}">Open Module Dossier</button></div>
      </article>
    `).join("");
    $("#courseGrid").querySelectorAll("[data-complete]").forEach(btn => btn.addEventListener("click", () => {
      completed[btn.dataset.complete] = !completed[btn.dataset.complete];
      storage.set("completedModules", completed);
      renderCourse(); updateProgress();
    }));
    $("#courseGrid").querySelectorAll("[data-module]").forEach(btn => btn.addEventListener("click", () => openModule(DATA.modules.find(m => m.id === btn.dataset.module))));
    updateProgress();
  }

