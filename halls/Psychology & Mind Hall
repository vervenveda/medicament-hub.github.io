<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>ARSHIF Psychology & Mind Hall — Comprehensive Course Portal</title>
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<style>
#arshif-psych-hall {
  --psy-bg:#050711;
  --psy-panel:#111522;
  --psy-panel2:#181d2e;
  --psy-ink:#f8f0df;
  --psy-soft:#d8cbb5;
  --psy-muted:#a69880;
  --psy-gold:#d9b878;
  --psy-gold2:#b98b43;
  --psy-violet:#8b74c7;
  --psy-teal:#78a9a1;
  --psy-rose:#a85f70;
  --psy-green:#76946b;
  --psy-line:rgba(217,184,120,.28);
  --psy-shadow:0 24px 70px rgba(0,0,0,.72);
  --psy-radius:22px;
  font-family: Georgia, "Times New Roman", serif;
  color:var(--psy-ink);
  background:
    radial-gradient(circle at 12% 0%, rgba(139,116,199,.20), transparent 34%),
    radial-gradient(circle at 88% 8%, rgba(120,169,161,.18), transparent 33%),
    radial-gradient(circle at 50% 100%, rgba(217,184,120,.13), transparent 42%),
    linear-gradient(135deg,#080b14,#050711 70%);
  min-height:100vh;
  padding:24px;
  box-sizing:border-box;
}
#arshif-psych-hall * { box-sizing:border-box; }
#arshif-psych-hall button,
#arshif-psych-hall input,
#arshif-psych-hall textarea { font:inherit; }
#arshif-psych-hall a { color:var(--psy-gold); }
#arshif-psych-hall .psy-shell {
  max-width:1480px;
  margin:0 auto;
  border:1px solid var(--psy-line);
  border-radius:var(--psy-radius);
  box-shadow:var(--psy-shadow);
  overflow:hidden;
  background:linear-gradient(135deg,rgba(17,21,34,.98),rgba(7,9,17,.98));
}
#arshif-psych-hall .psy-hero {
  position:relative;
  padding:36px 26px 28px;
  text-align:center;
  border-bottom:1px solid var(--psy-line);
  background:
    linear-gradient(rgba(5,7,17,.28),rgba(5,7,17,.94)),
    repeating-radial-gradient(circle at 50% -10%, rgba(217,184,120,.08) 0 1px, transparent 1px 24px);
}
#arshif-psych-hall .psy-kicker {
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--psy-gold);
  font-size:13px;
  margin-bottom:10px;
}
#arshif-psych-hall h1 {
  margin:0;
  font-size:clamp(32px,5vw,64px);
  letter-spacing:.12em;
  text-transform:uppercase;
  line-height:1.05;
}
#arshif-psych-hall .psy-subtitle {
  max-width:980px;
  margin:16px auto 0;
  color:var(--psy-soft);
  line-height:1.75;
  font-size:16px;
}
#arshif-psych-hall .psy-alert {
  max-width:1080px;
  margin:18px auto 0;
  padding:12px 16px;
  border:1px solid rgba(217,184,120,.36);
  border-radius:16px;
  color:#f3e5c8;
  background:rgba(0,0,0,.28);
  line-height:1.55;
  font-size:14px;
}
#arshif-psych-hall .psy-stats {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;
  margin:24px auto 0;
  max-width:980px;
}
#arshif-psych-hall .psy-stat {
  border:1px solid rgba(217,184,120,.24);
  background:rgba(255,255,255,.035);
  border-radius:16px;
  padding:12px 10px;
}
#arshif-psych-hall .psy-stat strong {
  display:block;
  font-size:24px;
  color:var(--psy-gold);
}
#arshif-psych-hall .psy-stat span {
  color:var(--psy-soft);
  font-size:12px;
  letter-spacing:.12em;
  text-transform:uppercase;
}
#arshif-psych-hall .psy-tabs {
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  justify-content:center;
  padding:14px;
  background:#0b0f19;
  border-bottom:1px solid rgba(217,184,120,.2);
  position:sticky;
  top:0;
  z-index:12;
}
#arshif-psych-hall .psy-tab {
  border:1px solid rgba(217,184,120,.38);
  background:rgba(255,255,255,.04);
  color:var(--psy-ink);
  border-radius:999px;
  padding:9px 13px;
  cursor:pointer;
  transition:.18s ease;
  font-size:13px;
  letter-spacing:.08em;
  text-transform:uppercase;
}
#arshif-psych-hall .psy-tab:hover,
#arshif-psych-hall .psy-tab.active {
  background:linear-gradient(135deg,var(--psy-gold),var(--psy-gold2));
  color:#160e06;
  transform:translateY(-1px);
}
#arshif-psych-hall .psy-view { display:none; padding:22px; }
#arshif-psych-hall .psy-view.active { display:block; }
#arshif-psych-hall .psy-layout {
  display:grid;
  grid-template-columns:315px 1fr;
  gap:18px;
}
#arshif-psych-hall .psy-side,
#arshif-psych-hall .psy-card,
#arshif-psych-hall .psy-tool,
#arshif-psych-hall .psy-panel {
  border:1px solid rgba(217,184,120,.22);
  background:
    linear-gradient(160deg,rgba(255,255,255,.055),rgba(255,255,255,.018)),
    rgba(0,0,0,.18);
  border-radius:18px;
}
#arshif-psych-hall .psy-side { padding:16px; align-self:start; position:sticky; top:78px; }
#arshif-psych-hall .psy-side h2,
#arshif-psych-hall .psy-section-title {
  margin:0 0 12px;
  color:var(--psy-gold);
  letter-spacing:.13em;
  text-transform:uppercase;
  font-size:18px;
}
#arshif-psych-hall .psy-search {
  width:100%;
  border:1px solid rgba(217,184,120,.38);
  background:rgba(0,0,0,.35);
  color:var(--psy-ink);
  border-radius:14px;
  padding:12px 13px;
  outline:none;
  margin-bottom:12px;
}
#arshif-psych-hall .psy-filter-group { margin:14px 0; }
#arshif-psych-hall .psy-filter-title {
  color:var(--psy-soft);
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:.14em;
  margin-bottom:8px;
}
#arshif-psych-hall .psy-chip-row { display:flex; flex-wrap:wrap; gap:7px; }
#arshif-psych-hall .psy-chip {
  border:1px solid rgba(217,184,120,.28);
  background:rgba(255,255,255,.035);
  color:var(--psy-soft);
  border-radius:999px;
  padding:6px 9px;
  font-size:12px;
  cursor:pointer;
  transition:.15s;
}
#arshif-psych-hall .psy-chip:hover,
#arshif-psych-hall .psy-chip.active {
  color:#160e06;
  background:var(--psy-gold);
  border-color:var(--psy-gold);
}
#arshif-psych-hall .psy-countline {
  color:var(--psy-muted);
  font-size:13px;
  line-height:1.45;
  margin-top:10px;
}
#arshif-psych-hall .psy-grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:14px;
}
#arshif-psych-hall .psy-card {
  padding:16px;
  position:relative;
  min-height:230px;
  display:flex;
  flex-direction:column;
  overflow:hidden;
}
#arshif-psych-hall .psy-card::before {
  content:"";
  position:absolute;
  inset:0 0 auto 0;
  height:4px;
  background:linear-gradient(90deg,var(--psy-gold),var(--psy-violet),transparent);
  opacity:.85;
}
#arshif-psych-hall .psy-badge {
  display:inline-flex;
  width:max-content;
  max-width:100%;
  border:1px solid rgba(217,184,120,.35);
  background:rgba(0,0,0,.25);
  color:var(--psy-gold);
  border-radius:999px;
  padding:4px 8px;
  font-size:12px;
  margin-bottom:10px;
}
#arshif-psych-hall .psy-card h3 {
  margin:0 0 8px;
  font-size:20px;
  line-height:1.2;
}
#arshif-psych-hall .psy-meta {
  color:var(--psy-muted);
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:.09em;
  line-height:1.4;
  margin-bottom:8px;
}
#arshif-psych-hall .psy-card p {
  margin:0 0 12px;
  color:var(--psy-soft);
  line-height:1.56;
  font-size:14px;
}
#arshif-psych-hall .psy-actions {
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:auto;
}
#arshif-psych-hall .psy-btn {
  border:1px solid rgba(217,184,120,.4);
  background:rgba(0,0,0,.25);
  color:var(--psy-ink);
  border-radius:999px;
  padding:8px 11px;
  cursor:pointer;
  font-size:13px;
  transition:.15s;
}
#arshif-psych-hall .psy-btn:hover {
  background:rgba(217,184,120,.16);
  transform:translateY(-1px);
}
#arshif-psych-hall .psy-btn.gold {
  background:linear-gradient(135deg,var(--psy-gold),var(--psy-gold2));
  color:#160e06;
  border-color:transparent;
}
#arshif-psych-hall .psy-btn.danger {
  border-color:rgba(168,95,112,.65);
  color:#ffd7df;
}
#arshif-psych-hall .psy-course-grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:14px;
}
#arshif-psych-hall .psy-module {
  padding:16px;
  border-radius:18px;
  border:1px solid rgba(217,184,120,.22);
  background:rgba(255,255,255,.035);
}
#arshif-psych-hall .psy-module-top {
  display:flex;
  gap:10px;
  justify-content:space-between;
  align-items:flex-start;
}
#arshif-psych-hall .psy-module h3 { margin:0 0 8px; color:var(--psy-ink); }
#arshif-psych-hall .psy-module p { color:var(--psy-soft); line-height:1.55; margin:0 0 10px; }
#arshif-psych-hall .psy-check {
  min-width:34px;
  min-height:34px;
  border-radius:50%;
  border:1px solid rgba(217,184,120,.45);
  background:rgba(0,0,0,.25);
  color:var(--psy-gold);
  cursor:pointer;
}
#arshif-psych-hall .psy-check.done {
  background:var(--psy-green);
  color:white;
  border-color:var(--psy-green);
}
#arshif-psych-hall .psy-objectives {
  margin:8px 0;
  padding-left:18px;
  color:var(--psy-soft);
  line-height:1.55;
  font-size:14px;
}
#arshif-psych-hall .psy-timeline {
  position:relative;
  margin:0;
  padding:0;
  list-style:none;
}
#arshif-psych-hall .psy-timeline li {
  display:grid;
  grid-template-columns:150px 1fr;
  gap:16px;
  padding:14px 0;
  border-bottom:1px solid rgba(217,184,120,.16);
}
#arshif-psych-hall .psy-timeline time {
  color:var(--psy-gold);
  font-weight:bold;
}
#arshif-psych-hall .psy-timeline span {
  color:var(--psy-soft);
  line-height:1.55;
}
#arshif-psych-hall .psy-source-grid,
#arshif-psych-hall .psy-glossary-grid,
#arshif-psych-hall .psy-tools-grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:14px;
}
#arshif-psych-hall .psy-source-card,
#arshif-psych-hall .psy-glossary-card {
  border:1px solid rgba(217,184,120,.22);
  border-radius:16px;
  padding:14px;
  background:rgba(255,255,255,.035);
}
#arshif-psych-hall .psy-source-card h3,
#arshif-psych-hall .psy-glossary-card h3,
#arshif-psych-hall .psy-tool h3 { margin:0 0 8px; color:var(--psy-gold); }
#arshif-psych-hall .psy-source-card p,
#arshif-psych-hall .psy-glossary-card p,
#arshif-psych-hall .psy-tool p { color:var(--psy-soft); line-height:1.55; margin:0 0 10px; }
#arshif-psych-hall .psy-tool { padding:16px; }
#arshif-psych-hall textarea.psy-textarea {
  width:100%;
  min-height:140px;
  border:1px solid rgba(217,184,120,.35);
  background:rgba(0,0,0,.32);
  color:var(--psy-ink);
  border-radius:14px;
  padding:12px;
  resize:vertical;
  outline:none;
}
#arshif-psych-hall .psy-output {
  white-space:pre-wrap;
  border:1px solid rgba(217,184,120,.22);
  background:rgba(0,0,0,.23);
  border-radius:14px;
  padding:12px;
  min-height:110px;
  color:var(--psy-soft);
  line-height:1.55;
  margin-top:10px;
}
#arshif-psych-hall .psy-quiz-box {
  max-width:860px;
  margin:0 auto;
  border:1px solid rgba(217,184,120,.25);
  background:rgba(255,255,255,.035);
  border-radius:18px;
  padding:18px;
}
#arshif-psych-hall .psy-quiz-question {
  font-size:22px;
  color:var(--psy-gold);
  margin-bottom:14px;
}
#arshif-psych-hall .psy-option {
  width:100%;
  text-align:left;
  border:1px solid rgba(217,184,120,.26);
  background:rgba(0,0,0,.25);
  color:var(--psy-ink);
  border-radius:14px;
  padding:11px 13px;
  margin:7px 0;
  cursor:pointer;
}
#arshif-psych-hall .psy-option.correct { background:rgba(118,148,107,.35); border-color:rgba(118,148,107,.85); }
#arshif-psych-hall .psy-option.wrong { background:rgba(168,95,112,.35); border-color:rgba(168,95,112,.85); }
#arshif-psych-hall .psy-progressbar {
  height:13px;
  border-radius:999px;
  overflow:hidden;
  border:1px solid rgba(217,184,120,.25);
  background:rgba(0,0,0,.32);
  margin:10px 0 14px;
}
#arshif-psych-hall .psy-progressbar span {
  display:block;
  height:100%;
  background:linear-gradient(90deg,var(--psy-gold),var(--psy-teal));
  width:0%;
}
#arshif-psych-hall .psy-modal-backdrop {
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.58);
  display:none;
  z-index:60;
}
#arshif-psych-hall .psy-modal-backdrop.open { display:block; }
#arshif-psych-hall .psy-dossier {
  position:fixed;
  top:72px;
  left:50%;
  transform:translateX(-50%);
  width:min(940px,calc(100vw - 28px));
  max-height:calc(100vh - 96px);
  overflow:auto;
  border:1px solid rgba(217,184,120,.55);
  background:
    radial-gradient(circle at top left, rgba(139,116,199,.18), transparent 40%),
    linear-gradient(135deg,#171b2a,#080b14);
  box-shadow:0 30px 100px rgba(0,0,0,.82);
  border-radius:20px;
  display:none;
  z-index:70;
}
#arshif-psych-hall .psy-dossier.open { display:block; }
#arshif-psych-hall .psy-dossier-head {
  padding:14px 16px;
  border-bottom:1px solid rgba(217,184,120,.22);
  display:flex;
  justify-content:space-between;
  gap:12px;
  align-items:center;
  cursor:grab;
  background:rgba(0,0,0,.18);
  position:sticky;
  top:0;
  z-index:2;
}
#arshif-psych-hall .psy-dossier-head h2 {
  margin:0;
  color:var(--psy-gold);
  letter-spacing:.08em;
  text-transform:uppercase;
  font-size:20px;
}
#arshif-psych-hall .psy-dossier-body { padding:18px; }
#arshif-psych-hall .psy-dossier-section {
  border:1px solid rgba(217,184,120,.18);
  background:rgba(255,255,255,.028);
  border-radius:16px;
  padding:14px;
  margin-bottom:12px;
}
#arshif-psych-hall .psy-dossier-section h3 { margin:0 0 8px; color:var(--psy-gold); }
#arshif-psych-hall .psy-dossier-section p,
#arshif-psych-hall .psy-dossier-section li { color:var(--psy-soft); line-height:1.58; }
#arshif-psych-hall .psy-link-list { padding-left:18px; margin:8px 0 0; }
#arshif-psych-hall .psy-link-list li { margin:6px 0; }
#arshif-psych-hall .psy-footer {
  padding:16px;
  text-align:center;
  color:var(--psy-muted);
  border-top:1px solid rgba(217,184,120,.18);
  background:#080b14;
  line-height:1.55;
}
#arshif-psych-hall .psy-small { color:var(--psy-muted); font-size:13px; line-height:1.45; }
@media (max-width:1100px) {
  #arshif-psych-hall .psy-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  #arshif-psych-hall .psy-source-grid,
  #arshif-psych-hall .psy-glossary-grid,
  #arshif-psych-hall .psy-tools-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media (max-width:860px) {
  #arshif-psych-hall { padding:10px; }
  #arshif-psych-hall .psy-layout { grid-template-columns:1fr; }
  #arshif-psych-hall .psy-side { position:relative; top:auto; }
  #arshif-psych-hall .psy-grid,
  #arshif-psych-hall .psy-course-grid,
  #arshif-psych-hall .psy-source-grid,
  #arshif-psych-hall .psy-glossary-grid,
  #arshif-psych-hall .psy-tools-grid,
  #arshif-psych-hall .psy-stats { grid-template-columns:1fr; }
  #arshif-psych-hall .psy-timeline li { grid-template-columns:1fr; gap:5px; }
  #arshif-psych-hall .psy-tabs { position:relative; top:auto; }
}
@media print {
  body * { visibility:hidden; }
  #arshif-psych-hall, #arshif-psych-hall * { visibility:visible; }
  #arshif-psych-hall { background:white !important; color:#111 !important; padding:0; }
  #arshif-psych-hall .psy-tabs, #arshif-psych-hall .psy-actions, #arshif-psych-hall .psy-side, #arshif-psych-hall .psy-modal-backdrop, #arshif-psych-hall .psy-dossier { display:none !important; }
  #arshif-psych-hall .psy-view { display:block !important; page-break-after:always; }
}
</style>
</head>
<body>
<div id="arshif-psych-hall">
  <div class="psy-shell">
    <header class="psy-hero">
      <div class="psy-kicker">ARSHIF · Mind Archive · Psychology Course</div>
      <h1>Psychology & Mind Hall</h1>
      <p class="psy-subtitle">
        A comprehensive portal for the study of mind, behavior, development, emotion, memory,
        culture, relationships, healing systems, research methods, ethics, and the mystery of human experience.
      </p>
      <div class="psy-alert">
        <strong>Care boundary:</strong> This portal is educational. It does not diagnose, treat, or replace
        licensed mental-health care, medical care, or crisis support. If someone may be in immediate danger,
        contact local emergency services or a trusted qualified professional.
      </div>
      <div class="psy-stats">
        <div class="psy-stat"><strong id="statDossiers">0</strong><span>Dossiers</span></div>
        <div class="psy-stat"><strong id="statModules">0</strong><span>Modules</span></div>
        <div class="psy-stat"><strong id="statDepartments">0</strong><span>Departments</span></div>
        <div class="psy-stat"><strong id="statProgress">0%</strong><span>Progress</span></div>
      </div>
    </header>

    <nav class="psy-tabs" aria-label="Portal sections">
      <button class="psy-tab active" data-view="archive">Archive</button>
      <button class="psy-tab" data-view="course">Course</button>
      <button class="psy-tab" data-view="departments">Departments</button>
      <button class="psy-tab" data-view="timeline">Timeline</button>
      <button class="psy-tab" data-view="sourcevault">Source Vault</button>
      <button class="psy-tab" data-view="glossary">Glossary</button>
      <button class="psy-tab" data-view="quiz">Quiz Chamber</button>
      <button class="psy-tab" data-view="studio">Mind Studio</button>
      <button class="psy-tab" data-view="progress">Progress</button>
    </nav>

    <section class="psy-view active" id="view-archive">
      <div class="psy-layout">
        <aside class="psy-side">
          <h2>Mind Archive</h2>
          <input class="psy-search" id="archiveSearch" placeholder="Search memory, trauma, learning, culture, therapy, cognition..." />
          <div class="psy-filter-group">
            <div class="psy-filter-title">Department</div>
            <div class="psy-chip-row" id="departmentChips"></div>
          </div>
          <div class="psy-filter-group">
            <div class="psy-filter-title">Era</div>
            <div class="psy-chip-row" id="eraChips"></div>
          </div>
          <div class="psy-countline" id="archiveCount"></div>
          <button class="psy-btn danger" id="clearFilters">Clear filters</button>
        </aside>
        <main>
          <h2 class="psy-section-title">Psychology & Mind Dossiers</h2>
          <div class="psy-grid" id="dossierGrid"></div>
        </main>
      </div>
    </section>

    <section class="psy-view" id="view-course">
      <h2 class="psy-section-title">Comprehensive Course Path</h2>
      <p class="psy-small">Complete modules in any order. Progress is saved locally in this browser.</p>
      <div class="psy-progressbar"><span id="courseProgressBar"></span></div>
      <div class="psy-course-grid" id="courseGrid"></div>
    </section>

    <section class="psy-view" id="view-departments">
      <h2 class="psy-section-title">Department Halls</h2>
      <p class="psy-small">Explore the mind by department: from neuroscience and cognition to culture, therapy, community, technology, and public mental health.</p>
      <div class="psy-grid" id="departmentGrid"></div>
    </section>

    <section class="psy-view" id="view-timeline">
      <h2 class="psy-section-title">Psychology Timeline</h2>
      <ul class="psy-timeline" id="timelineList"></ul>
    </section>

    <section class="psy-view" id="view-sourcevault">
      <h2 class="psy-section-title">Source Vault</h2>
      <p class="psy-small">Use professional and official resources first. Public education pages can help with language, but research and care decisions require careful verification.</p>
      <div class="psy-source-grid" id="sourceGrid"></div>
    </section>

    <section class="psy-view" id="view-glossary">
      <h2 class="psy-section-title">Glossary</h2>
      <div class="psy-glossary-grid" id="glossaryGrid"></div>
    </section>

    <section class="psy-view" id="view-quiz">
      <h2 class="psy-section-title">Quiz Chamber</h2>
      <div class="psy-quiz-box">
        <div class="psy-small" id="quizScore"></div>
        <div class="psy-quiz-question" id="quizQuestion"></div>
        <div id="quizOptions"></div>
        <div class="psy-output" id="quizExplain"></div>
        <div class="psy-actions" style="margin-top:12px;">
          <button class="psy-btn gold" id="nextQuiz">Next Question</button>
          <button class="psy-btn" id="resetQuiz">Reset Score</button>
        </div>
