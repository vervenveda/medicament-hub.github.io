    const note = dossierNotes[d.id] || "";
    $("#modalTitle").textContent = d.title;
    $("#modalBody").innerHTML = `
      <div class="psy-dossier-section">
        <span class="psy-badge">${escapeHTML(d.badge)} · ${escapeHTML(d.department)} · ${escapeHTML(d.era)}</span>
        <p>${escapeHTML(d.summary)}</p>
      </div>
      <div class="psy-dossier-section"><h3>Context</h3><p>${escapeHTML(d.historicalContext)}</p></div>
      <div class="psy-dossier-section"><h3>Key Questions</h3><ul>${d.keyQuestions.map(q => `<li>${escapeHTML(q)}</li>`).join("")}</ul></div>
      <div class="psy-dossier-section"><h3>Learning Use</h3><p>${escapeHTML(d.learningUse)}</p></div>
      <div class="psy-dossier-section"><h3>Reading Links</h3><ul class="psy-link-list">${d.links.map(l => `<li><a href="${escapeHTML(l.url)}" target="_blank" rel="noopener">${escapeHTML(l.label)}</a></li>`).join("")}</ul></div>
      <div class="psy-dossier-section">
        <h3>Personal Notes</h3>
        <textarea class="psy-textarea" id="dossierNoteBox" placeholder="Your notes on ${escapeHTML(d.title)}...">${escapeHTML(note)}</textarea>
        <div class="psy-actions" style="margin-top:8px;"><button class="psy-btn gold" id="saveDossierNote">Save Note</button></div>
      </div>
    `;
    $("#saveDossierNote").addEventListener("click", () => {
      dossierNotes[d.id] = $("#dossierNoteBox").value;
      storage.set("dossierNotes", dossierNotes);
      $("#saveDossierNote").textContent = "Saved ✓";
      setTimeout(() => $("#saveDossierNote").textContent = "Save Note", 900);
    });
    openModal();
  }

  function openModule(m) {
    if(!m) return;
    $("#modalTitle").textContent = m.title;
    $("#modalBody").innerHTML = `
      <div class="psy-dossier-section">
        <span class="psy-badge">${escapeHTML(m.level)} · ${escapeHTML(m.department)}</span>
        <p>${escapeHTML(m.summary)}</p>
      </div>
      <div class="psy-dossier-section"><h3>Objectives</h3><ul>${m.objectives.map(o => `<li>${escapeHTML(o)}</li>`).join("")}</ul></div>
      <div class="psy-dossier-section"><h3>Learning Activity</h3><p>${escapeHTML(m.activity)}</p></div>
      <div class="psy-dossier-section"><h3>Suggested Dossiers</h3><ul>${DATA.dossiers.filter(d=>d.department===m.department).slice(0,8).map(d=>`<li>${escapeHTML(d.title)} — ${escapeHTML(d.summary)}</li>`).join("") || "<li>Use the archive search to locate related dossiers.</li>"}</ul></div>
      <div class="psy-dossier-section"><h3>Reflection Prompt</h3><p>What did this topic help you notice about behavior, mind, culture, body, relationships, and ethics? What would require professional care rather than self-study?</p></div>
    `;
    openModal();
  }

  function openModal() { $("#modalBackdrop").classList.add("open"); $("#dossierModal").classList.add("open"); }
  function closeModal() { $("#modalBackdrop").classList.remove("open"); $("#dossierModal").classList.remove("open"); }

  function modalDragInit() {
    const modal = $("#dossierModal");
    const handle = $("#dossierDragHandle");
    let dragging=false, startX=0, startY=0, startLeft=0, startTop=0;
    handle.addEventListener("mousedown", e => {
      dragging=true;
      const rect = modal.getBoundingClientRect();
      modal.style.left = rect.left + "px";
      modal.style.top = rect.top + "px";
      modal.style.transform = "none";
      startX=e.clientX; startY=e.clientY; startLeft=rect.left; startTop=rect.top;
      document.body.style.userSelect="none";
    });
    window.addEventListener("mousemove", e => {
      if(!dragging) return;
      modal.style.left = Math.max(6, Math.min(window.innerWidth - 60, startLeft + e.clientX - startX)) + "px";
      modal.style.top = Math.max(6, Math.min(window.innerHeight - 60, startTop + e.clientY - startY)) + "px";
    });
    window.addEventListener("mouseup", () => { dragging=false; document.body.style.userSelect=""; });
  }

  function updateProgress() {
    const done = Object.values(completed).filter(Boolean).length;
    const total = DATA.modules.length;
    const pct = total ? Math.round(done/total*100) : 0;
    $("#statProgress").textContent = pct + "%";
    $("#courseProgressBar").style.width = pct + "%";
    $("#progressBar2").style.width = pct + "%";
    $("#progressSummary").textContent = `Completed ${done} of ${total} course modules. Favorited ${Object.values(favorites).filter(Boolean).length} dossiers. Saved ${Object.values(dossierNotes).filter(v=>String(v||"").trim()).length} dossier notes.`;
  }

  function renderQuiz() {
    const q = DATA.quiz[state.quizIndex % DATA.quiz.length];
    $("#quizScore").textContent = `Question ${state.quizIndex + 1} · Score: ${state.quizScore}`;
    $("#quizQuestion").textContent = q.q;
    $("#quizExplain").textContent = "";
    state.quizAnswered=false;
    $("#quizOptions").innerHTML = q.options.map((opt, i) => `<button class="psy-option" data-opt="${i}">${escapeHTML(opt)}</button>`).join("");
    $("#quizOptions").querySelectorAll("[data-opt]").forEach(btn => btn.addEventListener("click", () => {
      if(state.quizAnswered) return;
      state.quizAnswered=true;
      const choice = Number(btn.dataset.opt);
      const options = $("#quizOptions").querySelectorAll(".psy-option");
      options.forEach((b,i) => b.classList.add(i === q.answer ? "correct" : (i === choice ? "wrong" : "")));
      if(choice === q.answer) state.quizScore++;
      $("#quizExplain").textContent = q.why;
      $("#quizScore").textContent = `Question ${state.quizIndex + 1} · Score: ${state.quizScore}`;
    }));
  }

  function studioInit() {
    const templates = {
      research:`RESEARCH QUESTION BUILDER\n\n1. Topic of curiosity:\n2. Population or context:\n3. Behavior / mental process / outcome:\n4. Possible predictor or condition:\n5. Research question:\n6. Hypothesis, if appropriate:\n7. Variables and how each could be measured:\n8. Design: descriptive / correlational / experimental / qualitative / mixed:\n9. Ethical considerations:\n10. What result would NOT prove:\n11. Sources to check:`,
      bias:`COGNITIVE BIAS MAPPER\n\nDecision or belief:\nEvidence I noticed:\nEvidence I may have ignored:\nPossible confirmation bias:\nPossible availability bias:\nPossible sunk cost or loss aversion:\nPossible group pressure or identity pressure:\nAlternative explanations:\nWhat would change my mind?\nSmall next step:`,
      emotion:`EMOTION VOCABULARY JOURNAL\n\nSituation:\nBody sensations:\nEmotion words, from broad to precise:\nThoughts or interpretations:\nUrges or impulses:\nNeed or value underneath:\nWhat helped, even a little?\nWhat support would be appropriate?\nImportant boundary: this is reflection, not diagnosis.`,
      habit:`HABIT LOOP MAP\n\nHabit to understand:\nCue / trigger:\nContext: time, place, people, emotion:\nBehavior:\nReward or relief:\nCost or consequence:\nFriction to add or remove:\nReplacement behavior:\nSupportive environment change:\nHow to measure gently:`,
      learning:`LEARNING DESIGN PLANNER\n\nSkill or concept:\nLearner age/context:\nAttention hook:\nPrior knowledge activation:\nSmall explanation:\nRetrieval practice question:\nSpacing/review plan:\nMotivation and relevance:\nBelonging and safety cues:\nAccessibility / UDL supports:\nHow progress will be shown:`,
      digital:`DIGITAL WELLBEING AUDIT\n\nApp/platform/tool:\nPurpose it serves:\nAttention design: notifications, infinite scroll, streaks, autoplay:\nSocial comparison pressure:\nPrivacy/data concerns:\nDoes it support or drain relationships?\nBest use boundary:\nOne setting to change:\nOne offline replacement/support:\nRecheck date:`
    };
    $$(".psy-tool [data-tool]").forEach(btn => {
      btn.addEventListener("click", () => { $("#tool-" + btn.dataset.tool).textContent = templates[btn.dataset.tool]; });
    });
  }

  function progressInit() {
    $("#generalNotes").value = generalNotes;
    $("#generalNotes").addEventListener("input", () => {
      generalNotes = $("#generalNotes").value;
      storage.set("generalNotes", generalNotes);
    });
    $("#printProgress").addEventListener("click", () => window.print());
    $("#downloadNotes").addEventListener("click", () => {
      const payload = { exportedAt:new Date().toISOString(), completedModules:completed, favorites:favorites, dossierNotes:dossierNotes, generalNotes:generalNotes };
      const blob = new Blob([JSON.stringify(payload,null,2)], {type:"application/json"});
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "arshif-psychology-mind-notes.json";
      a.click();
      URL.revokeObjectURL(a.href);
    });
    $("#resetProgress").addEventListener("click", () => {
      if(confirm("Reset completed modules, favorites, and notes for this portal?")) {
        completed={}; favorites={}; dossierNotes={}; generalNotes="";
        ["completedModules","favorites","dossierNotes","generalNotes"].forEach(k => localStorage.removeItem("arshifPsychMind:" + k));
        $("#generalNotes").value="";
        renderArchive(); renderCourse(); updateProgress();
      }
    });
  }

  function init() {
    $("#statDossiers").textContent = DATA.dossiers.length;
    $("#statModules").textContent = DATA.modules.length;
    $("#statDepartments").textContent = DATA.departments.length;
    tabInit(); renderChips(); renderArchive(); renderCourse(); renderDepartments(); renderTimeline(); renderSources(); renderGlossary(); renderQuiz(); studioInit(); progressInit(); modalDragInit(); updateProgress();
    $("#archiveSearch").addEventListener("input", e => { state.search = e.target.value; renderArchive(); });
    $("#clearFilters").addEventListener("click", () => { state.department="All"; state.era="All"; state.search=""; $("#archiveSearch").value=""; renderChips(); renderArchive(); });
    $("#closeModal").addEventListener("click", closeModal);
    $("#modalBackdrop").addEventListener("click", closeModal);
    $("#nextQuiz").addEventListener("click", () => { state.quizIndex++; renderQuiz(); });
    $("#resetQuiz").addEventListener("click", () => { state.quizIndex=0; state.quizScore=0; renderQuiz(); });
  }
  init();
})();
</script>
</body>
</html>
